{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>rysk-tanaka/workflows#d5a542fb1ec5e23efa47ccf1a4f8dbbe8a92d71a"
  ],
  "enabledManagers": ["npm", "github-actions", "custom.regex"],
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "workers-types と wrangler は日付ベースで頻繁に更新されるため 1 本の PR にまとめる",
      "matchPackageNames": ["wrangler", "@cloudflare/workers-types"],
      "groupName": "cloudflare"
    }
  ]
}
